@echo off
chcp 65001 >nul
title الشاطبية التفاعلية — خادم محلي للابتوب والهاتف
echo ============================================================
echo   تشغيل الشاطبية التفاعلية على اللابتوب والهاتف (Wi-Fi)
echo ============================================================
echo.
echo 1) للفتح على اللابتوب:
echo    http://localhost:8000
echo.
echo 2) للفتح على هاتفك (تأكد أن الهاتف واللابتوب على نفس شبكة Wi-Fi):
for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr /R /C:"IPv4"') do (
    for /f "tokens=* delims= " %%b in ("%%a") do echo    http://%%b:8000
)
echo.
echo (أبقِ هذه النافذة مفتوحة أثناء التصفح من الهاتف)
echo ============================================================
start http://localhost:8000
python -m http.server 8000 --bind 0.0.0.0
